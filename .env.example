# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection (matches docker-compose.yml defaults if you use it)
DATABASE_URL=postgresql://kriyon:kriyon@localhost:5432/kriyon_bd

# Anthropic API key, used only by scoring/classifier.py
ANTHROPIC_API_KEY=

# Anthropic model used for classification and drafting
ANTHROPIC_MODEL=claude-sonnet-5

# TED Search API base URL (no auth required as of Phase 1 research; override if it changes)
TED_API_BASE_URL=https://api.ted.europa.eu/v3

# Where daily digests are written
DIGEST_OUTPUT_DIR=./data/digests

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
